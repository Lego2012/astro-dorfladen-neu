---
import Layout from "../layouts/Layout.astro";
import Oeffnung from "../components/Oeffnungszeiten.astro";

const aufrufe = {
   text1: "<strong>Zur Unterstützung des Teams</strong> suchen wir ehrenamtliche Helfer für das Projekt Lieferservice.",
   text2: "Weiter benötigen wir <strong>Mitarbeiter</strong> für die Reinigung der Räume sowie das Auffüllen der Regale.",
   text3: "Bitte melden Sie sich im <strong>Laden</strong> oder mit einer <strong>E-Mail</strong> über das Kontaktformular.",
};
---

<style>
   .radius {
      border-radius: 1rem;
   }
</style>
<Layout>
   <section id="secondary-banner" class="dynamic-image-1">
      <div class="container">
         <div class="row">
            <div class="col-lg-12">
               <h2>Kontakt zu uns</h2>
               <h4>Auch hier immer für Sie da</h4>
            </div>
         </div>
      </div>
   </section>
   <div class="message-shadow"></div>
   <div class="clearfix"></div>
   <section class="content">
      <div class="container">
         <div class="inner-page">
            <div class="col-md-12 padding-none">
               <div class="row">
                  <div
                     class="parallax_parent design_2 margin-bottom-40 margin-top-30"
                  >
                     <div
                        class="parallax_scroll clearfix"
                        data-velocity="-.5"
                        data-offset="-200"
                     >
                        <div class="overlay radius">
                           <div class="container radius">
                              <Oeffnung />
                           </div>
                        </div>
                     </div>
                  </div>
               </div>
               <hr />
               <div class="find_map row clearfix">
                  <h2 class="margin-bottom-25 margin-top-none">
                     Hier finden Sie uns
                  </h2>
                  <div class="map margin-vertical-30">
                     <img
                        src="/images/map-kontakt.png"
                        alt="Map Dorfladen Grohnde"
                     />
                  </div>
               </div>
               <div class="row contacts margin-top-25">
                  <div class="col-sm-7 left-information">
                     <div class="contact_information information_head clearfix">
                        <h3 class="margin-bottom-25 margin-top-none">
                           Kontaktinformationen
                        </h3>
                        <div
                           class="address clearfix margin-right-25 padding-bottom-40"
                        >
                           <div class="icon_address">
                              <p>
                                 <i class="fa fa-map-marker"></i><strong
                                    >Adresse:</strong
                                 >
                              </p>
                           </div>
                           <div class="contact_address">
                              <p class="margin-bottom-none">
                                 Dorfladen Grohnde<br />Patweg 29<br />31860
                                 Emmerthal-Grohnde
                              </p>
                           </div>
                        </div>
                        <div
                           class="address clearfix address_details margin-right-25 padding-bottom-40"
                        >
                           <ul class="margin-bottom-none">
                              <li class="padding-bottom-none">
                                 <i class="fa fa-laptop"></i><strong
                                    >Web:</strong
                                 >
                                 <a href="https://dorfladen-in-grohnde.de/"
                                    >www.dorfladen-in-grohnde.de</a
                                 >
                              </li>
                              <li class="padding-bottom-none">
                                 <i class="fa fa-envelope"></i><strong
                                    >Kontakt:</strong
                                 >
                                 05155 2819310
                              </li>
                              <li class="padding-bottom-none">
                                 <i class="fa fa-envelope"></i><strong
                                    >Fax:</strong
                                 > 05155 2819312
                              </li>
                           </ul>
                        </div>
                     </div>
                  </div>
                  <div class="col-sm-5">
                     <div
                        class="contact_information contact-formular information_head clearfix"
                     >
                        <h3 class="margin-bottom-25 margin-top-none">
                           Kontaktformular
                        </h3>
                        <div
                           class="address clearfix address_details margin-right-25 padding-bottom-40"
                        >
                           <form
                              action="https://formspree.io/f/maylzdrd"
                              method="POST"
                           >
                              <div class="row">
                                 <input
                                    type="text"
                                    name="name"
                                    placeholder="Ihr Vorname und Name"
                                 />
                              </div>
                              <div class="row">
                                 <input
                                    type="email"
                                    name="email"
                                    placeholder="Ihre Emailadresse eingeben"
                                 />
                              </div>
                              <div class="row">
                                 <textarea
                                    name="message"
                                    placeholder="Ihre Nachricht für uns"
                                 ></textarea>
                              </div><button type="submit">Abschicken</button>
                           </form>
                        </div>
                     </div>
                  </div>
                  <div class="clearfix"></div>

                  <!-- Aufrufe -->
                  <div
                     style="max-width: 100%;"
                     class="row well padding-top-60 padding-bottom-60"
                  >
                     <p class="unterstuetzung" set:html={aufrufe.text1} />
                     <br />
                     <p class="unterstuetzung" set:html={aufrufe.text2} />
                     <br />
                     <p class="unterstuetzung" set:html={aufrufe.text3} />
                     <br />
                  </div>
               </div>
               <div class="clearfix"></div>
            </div>
         </div>
      </div>
   </section>
</Layout>
