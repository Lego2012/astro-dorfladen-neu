---
import Layout from "../layouts/Layout.astro";

import Dorfladen_Angebote from "../components/DorfladenAngebote.astro";
---

<style lang="scss">
   h2 {
      text-align: center;
      padding-block-end: 2rem;
      margin-block-end: 0;

      p {
         margin-block-end: 1rem;
      }
   }

   .section__eins .inner-page {
      margin-bottom: 0;
   }
</style>

<Layout>
   <section id="secondary-banner" class="dynamic-image-1">
      <div class="container">
         <div class="row">
            <div class="col-lg-12">
               <h2>Unsere Angebote</h2>
               <h4>Regelmäßig frisch für Sie</h4>
            </div>
         </div>
      </div>
   </section>

   <div class="message-shadow"></div>

   <div class="clearfix"></div>

   <section class="content section__zwei">
      <div class="container">
         <div class="inner-page">
            <div class="find_team clearfix">
               <div class="row">
                  <div class="col-xs-12">
                     <!-- Angebote und Menüplan Einleitung -->
                     <div class="well padding-bottom-none">
                        <!-- Angebote Partial -->
                        <Dorfladen_Angebote />
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </section>
</Layout>
