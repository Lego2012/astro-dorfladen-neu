---
import Layout from "../layouts/Layout.astro";
---

<Layout>
   <section id="secondary-banner" class="dynamic-image-1">
      <div class="container">
         <div class="row">
            <div class="col-lg-12">
               <h2>Über uns - die Übersicht</h2>
               <h4>Der Laden und die Gesellschaft</h4>
            </div>
         </div>
      </div>
   </section>
   <div class="message-shadow"></div>
   <div class="clearfix"></div>
   <section>
      <div class="container">
         <div class="row ueber-uns">
            <div class="col-lg-6 ueber-uns">
               <div class="panel panel-default">
                  <div class="panel-heading">
                     <a href="/ueber-uns-detail/">
                        <p class="panel-title">Über uns</p>
                     </a>
                  </div>
                  <div class="panel-body">
                     <a href="/ueber-uns-detail/"
                        ><img
                           src="/images/schule/dorfladen_eingang_370x200.jpg"
                           width="450"
                           alt="Dorfladen Grohnde Schulgebäude"
                        /></a
                     >
                  </div>
                  <div class="panel-footer">
                     Schauen Sie mal in unseren Dorfladen hinein und lassen sich
                     überraschen, wie vielfältig und ausgewogen unsere
                     Produktpalette ist. Der Weg lohnt sich!
                  </div>
               </div>
            </div>
            <div class="col-lg-6 ueber-uns">
               <div class="panel panel-default">
                  <div class="panel-heading">
                     <a href="/dorfladen-ug/">
                        <p class="panel-title">Die Dorfladen-UG</p>
                     </a>
                  </div>
                  <div class="panel-body">
                     <a href="/dorfladen-ug/"
                        ><img
                           src="/images/gesellschaftervertrag.jpg"
                           alt="Gesellschaftsvertrag"
                        /></a
                     >
                  </div>
                  <div class="panel-footer">
                     Erfahren Sie hier, was die Unternehmergesellschaft ausmacht
                     und wie Sie mithelfen können, den Dorfladen in Grohnde auch
                     in den nächsten Jahren erfolgreich zu machen.
                  </div>
               </div>
            </div>
         </div>
      </div>
   </section>
</Layout>
