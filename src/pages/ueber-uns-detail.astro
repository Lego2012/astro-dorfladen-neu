---
import Layout from "../layouts/Layout.astro";
---

<Layout>
   <section id="secondary-banner" class="dynamic-image-1">
      <div class="container">
         <div class="row">
            <div class="col-lg-12">
               <a href="/ueber-uns/">
                  <h2>Über uns</h2>
               </a>
               <h4>Der Laden</h4>
            </div>
         </div>
      </div>
   </section>
   <div class="message-shadow"></div>
   <div class="clearfix"></div>
   <section class="content">
      <div class="container">
         <div class="inner-page about-us row">
            <div
               class="col-lg-8 col-md-8 col-sm-8 col-xs-12 padding-left-none padding-bottom-40 xs-padding-left-none xs-padding-right-none"
            >
               <h3 class="margin-bottom-25">Einkaufen, wo ich zu Hause bin</h3>
               <p>
                  Im Herzen des Ortes finden Sie ihn - den Dorfladen in Grohnde.
                  Gut erreichbar zu Fuß, im Dorf oder mit dem eigenen Pkw aus
                  den umliegenden Orten. Vor dem Laden stehen genügend
                  Parkplätze zur Verfügung.
               </p>
               <p>
                  Das Ergebnis von vielen Monaten Planung, kreativen Ideen,
                  Herzblut und engagierten Grohnder Bürgern.
               </p>
               <p>
                  <strong>Einkaufen, wo ich zu Hause bin</strong> meint vor allem
                  aber professionellen Umgang mit qualitativ hochwertigen Lebensmitteln
                  und anderen Waren des täglichen Bedarfs.
               </p>
               <p>Wir freuen uns auf Ihren Besuch!</p>
               <p>
                  <img
                     class="alignleft margin-top-10 margin-bottom-20 margin-right-25 margin-left-none"
                     src="/images/schule/dorfladen_eingang_370x200.jpg"
                     alt=""
                  />
               </p>
            </div>
            <div
               class="col-lg-4 col-md-4 col-sm-4 padding-right-none padding-bottom-40 xs-padding-left-none xs-padding-right-none"
            >
               <div class="right-container">
                  <h3 class="margin-bottom-25">
                     Worauf Sie sich freuen können:
                  </h3>
                  <div class="progressbar">
                     <div class="bs-example">
                        <div class="progress margin-bottom-15">
                           <div
                              class="progress-bar progress-bar-danger"
                              data-width="100"
                           >
                              Einkaufen
                           </div>
                        </div>
                        <div class="progress margin-bottom-15">
                           <div
                              class="progress-bar progress-bar-danger"
                              data-width="100"
                           >
                              Der Metzger
                           </div>
                        </div>
                        <div class="progress margin-bottom-15">
                           <div
                              class="progress-bar progress-bar-danger"
                              data-width="100"
                           >
                              Der Bäcker
                           </div>
                        </div>
                        <div class="progress margin-bottom-15">
                           <div
                              class="progress-bar progress-bar-danger"
                              data-width="100"
                           >
                              Das Café
                           </div>
                        </div>
                        <div class="progress margin-bottom-15">
                           <div
                              class="progress-bar progress-bar-danger"
                              data-width="100"
                           >
                              Leute treffen
                           </div>
                        </div>
                        <div class="progress margin-bottom-15">
                           <div
                              class="progress-bar progress-bar-danger"
                              data-width="100"
                           >
                              Schöne Atmosphäre
                           </div>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
            <div class="clearfix"></div>

            <hr class="sponsoren-hr" />

            <!-- PARTNER -->
            <div
