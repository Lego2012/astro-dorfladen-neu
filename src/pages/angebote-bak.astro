---
import Layout from "../layouts/Layout.astro";

import Dorfladen_Angebote from "../components/DorfladenAngebote.astro";
import Schulte_Angebote from "../components/SchulteAngebote.astro";
import Schulte_Menuplan from "../components/SchulteMenuplan.astro";

const angebote = {
   headline: "Auch 2025 immer wieder neu:",
   text: 'Angebote</a> und <a href="#menu">Menüplan</a> der Fleischerei Schulte',
};
---

<style lang="scss">
   h2 {
      text-align: center;
      padding-block-end: 2rem;
      margin-block-end: 0;

      p {
         margin-block-end: 1rem;
      }
   }

   .section__eins .inner-page {
      margin-bottom: 0;
   }
</style>

<Layout>
   <section id="secondary-banner" class="dynamic-image-1">
      <div class="container">
         <div class="row">
            <div class="col-lg-12">
               <h2>Unsere Angebote</h2>
               <h4>Regelmäßig frisch für Sie</h4>
            </div>
         </div>
      </div>
   </section>

   <div class="message-shadow"></div>

   <div class="clearfix"></div>

   <section class="content section__eins">
      <div class="container">
         <div class="inner-page">
            <div class="find_team clearfix">
               <div class="row">
                  <div class="col-xs-12">
                     <!-- Angebote und Menüplan Einleitung -->
                     <div class="well padding-bottom-none">
                        <h2>
                           <p><strong>{angebote.headline}</strong></p>
                           <a href="#angebote" set:html={angebote.text} />
                        </h2>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </section>

   <section class="content section__zwei">
      <div class="container">
         <div class="inner-page">
            <div class="find_team clearfix">
               <div class="row">
                  <div class="col-xs-12">
                     <!-- Angebote und Menüplan Einleitung -->
                     <div class="well padding-bottom-none">
                        <!-- Angebote Partial -->
                        <Dorfladen_Angebote />
                        <!-- Angebote Partial -->
                        <Schulte_Angebote />
                        <!-- Schulte Menüplan -->
                        <Schulte_Menuplan />
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </section>
</Layout>
