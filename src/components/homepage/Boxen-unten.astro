---
// IMPORTS
import texte from "../../data/texte.json";
---

<div class="row">
   <!-- LINKS -->
   <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 margin-bottom-none">
      <h4 class="text-center abstand margin-bottom-10 well">
         <Fragment set:html={texte.home.unten.links.header} />
      </h4>
      <div class="flip margin-bottom-10">
         <div class="card">
            <div class="face front">
               <img
                  class="img-responsive"
                  src="/images/schule/dorfladen_eingang_370x200.jpg"
                  alt=""
               />
            </div>
            <div class="face back">
               <div
                  class="hover_title"
                  set:html={texte.home.unten.links.back}
               />
               <a href="/historie">
                  <i class="fa fa-link button_icon"></i>
               </a>
            </div>
         </div>
      </div>
      <Fragment
         class="margin-bottom-none"
         set:html={texte.home.unten.links.text}
      />
   </div>

   <!-- MITTE -->
   <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 margin-bottom-none">
      <h4 class="text-center abstand margin-bottom-10 well">
         <Fragment set:html={texte.home.unten.mitte.header} />
      </h4>
      <div class="flip horizontal margin-bottom-10">
         <div class="card">
            <div class="face front">
               <img
                  class="img-responsive"
                  src="/images/baecker/startseite2.jpg"
                  alt=""
               />
            </div>
            <div class="face back">
               <div
                  class="hover_title"
                  set:html={texte.home.unten.mitte.back}
               />
               <a href="http://www.baeckerei-wegener.de/" target="_blank">
                  <i class="fa fa-link button_icon"></i>
               </a>
            </div>
         </div>
      </div>
      <Fragment
         class="margin-bottom-none"
         set:html={texte.home.unten.mitte.text}
      />
   </div>
</div>
