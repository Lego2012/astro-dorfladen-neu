---
const { headline, subheadline } = Astro.props;
---

<section class="message-wrap">
   <div class="container">
      <div class="row">
         <h2 class="col-lg-9 col-md-8 col-sm-12 col-xs-12 xs-padding-left-15">
            {headline}
         </h2>
         <div class="col-lg-3 col-md-4 col-sm-12 col-xs-12 xs-padding-right-15">
            <a
               href="/angebote"
               class="default-btn pull-right action_button lg-button"
               >{subheadline}</a
            >
         </div>
      </div>
   </div>
   <div class="message-shadow"></div>
</section>
