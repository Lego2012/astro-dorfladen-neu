---
// IMPORTS
import texte from "../../data/texte.json";
import "../../styles/custom-leo.css";
---

<div class="row">
   <!-- LINKS -->
   <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 margin-bottom-none">
      <h4 class="text-center abstand margin-bottom-10 well">
         <Fragment set:html={texte.home.oben.links.header} />
      </h4>
      <div class="flip horizontal margin-bottom-10">
         <div class="card">
            <div class="face front">
               <img
                  class="img-responsive"
                  src="/images/eroeffnung/eroeffnung3.jpg"
                  alt=""
               />
            </div>
            <div class="face back">
               <div class="hover_title">{texte.home.oben.links.back}</div>
               <a href="/ueber-uns">
                  <i class="fa fa-link button_icon"></i>
               </a>
            </div>
         </div>
      </div>
      <Fragment set:html={texte.home.oben.links.text} ! />
   </div>

   <!-- MITTE -->
   <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 margin-bottom-none">
      <h4 class="text-center abstand margin-bottom-10 well">
         <Fragment set:html={texte.home.oben.mitte.header} />
      </h4>
      <div class="flip margin-bottom-10">
         <div class="card">
            <div class="face front">
               <img
                  class="img-responsive"
                  src="/images/eroeffnung/eroeffnung1.jpg"
                  alt="Bild von der Eröffnung"
               />
            </div>
            <div class="face back">
               <div class="hover_title">{texte.home.oben.mitte.back}</div>
               <a href="/angebote">
                  <i class="fa fa-link button_icon"></i>
               </a>
            </div>
         </div>
      </div>
      <Fragment set:html={texte.home.oben.mitte.text} />
   </div>

   <!-- RECHTS -->
   <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 margin-bottom-none">
      <h4 class="text-center abstand margin-bottom-10 well">
         <Fragment set:html={texte.home.oben.rechts.header} />
      </h4>
      <div class="flip margin-bottom-10">
         <div class="card">
            <div class="face front">
               <img
                  class="img-responsive"
                  src="/images/eroeffnung/eroeffnung2.jpg"
                  alt=""
               />
            </div>
            <div class="face back">
               <div class="hover_title">{texte.home.oben.rechts.back}</div>
               <a href="/angebote">
                  <i class="fa fa-link button_icon"></i>
               </a>
            </div>
         </div>
      </div>
      <Fragment set:html={texte.home.oben.rechts.text} />
   </div>
</div>
