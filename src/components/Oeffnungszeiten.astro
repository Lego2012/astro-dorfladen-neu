---
import oeffnung from "../data/oeffnungszeiten.json";
---

<div class="row padding-bottom-60 padding-top-60">
   <div
      class="col-lg-12 col-md-12 col-sm-12 col-xs-12 padding-left-none xs-margin-bottom-none xs-padding-top-30 scroll_effect bounceInLeft"
   >
      <h2 class="oeffnungszeiten">Unsere Öffnungszeiten:</h2>
   </div>

   <div
      class="col-lg-4 col-md-4 col-sm-4 col-xs-12 padding-left-none xs-margin-bottom-none xs-padding-top-30 scroll_effect bounceInLeft"
   >
      <p><strong>Montag</strong><Fragment set:html={oeffnung.mo} /></p>
      <p><strong>Dienstag</strong><Fragment set:html={oeffnung.di} /></p>
   </div>

   <div
      class="col-lg-4 col-md-4 col-sm-4 col-xs-12 padding-left-none xs-margin-bottom-none xs-padding-top-30 scroll_effect bounceInLeft"
   >
      <p><strong>Mittwoch</strong><Fragment set:html={oeffnung.mi} /></p>
      <p><strong>Donnerstag</strong><Fragment set:html={oeffnung.do} /></p>
   </div>

   <div
      class="col-lg-4 col-md-4 col-sm-4 col-xs-12 padding-left-none xs-margin-bottom-none xs-padding-top-30 scroll_effect bounceInLeft"
   >
      <p><strong>Freitag</strong><Fragment set:html={oeffnung.fr} /></p>
      <p><strong>Samstag</strong><Fragment set:html={oeffnung.sa} /></p>
   </div>

   <div
      class="col-lg-4 col-md-4 col-sm-4 col-xs-12 padding-left-none xs-margin-bottom-none xs-padding-top-30 scroll_effect bounceInLeft"
   >
      <p><strong>Sonntag</strong><Fragment set:html={oeffnung.so} /></p>
   </div>
</div>

<style>
   .oeffnungszeiten {
      margin-bottom: 6rem;
   }
</style>
